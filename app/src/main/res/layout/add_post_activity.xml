<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context=".ui.dashboard.profile.ProfileActivity">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginTop="60dp"
        android:paddingVertical="10dp"
        android:paddingEnd="20dp"
        android:src="@drawable/back_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:includeFontPadding="false"
        android:text="Shto post"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_solid_white_top_right_left_radius_20dp"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="Firstname"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFirstName"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="7dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="LastName"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLastName"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="7dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBloodGroup"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintEnabled="false"
            app:hintTextColor="@color/cl_c8c5c3">

            <AutoCompleteTextView
                android:id="@+id/actvBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:enabled="false"
                android:fontFamily="@font/poppins"
                android:hint="Grupi i gjakut"
                android:imeOptions="flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="none"
                android:padding="15dp"
                android:textColor="@color/black"
                android:textColorHint="@color/cl_c8c5c3"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuantity"
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="Sasia"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuantity"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="7dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAge"
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="Mosha"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAge"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="7dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilURGENCY"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintEnabled="false"
            app:hintTextColor="@color/cl_c8c5c3">

            <AutoCompleteTextView
                android:id="@+id/actvUrgency"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:enabled="false"
                android:fontFamily="@font/poppins"
                android:hint="Urgjenca"
                android:imeOptions="flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="none"
                android:padding="15dp"
                android:textColor="@color/black"
                android:textColorHint="@color/cl_c8c5c3"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilhospital"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintEnabled="false"
            app:hintTextColor="@color/cl_c8c5c3">

            <AutoCompleteTextView
                android:id="@+id/actvHospital"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:enabled="false"
                android:fontFamily="@font/poppins"
                android:hint="Spitali"
                android:imeOptions="flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="none"
                android:padding="15dp"
                android:textColor="@color/black"
                android:textColorHint="@color/cl_c8c5c3"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilLastName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="9dp"
                android:focusable="false"
                android:fontFamily="@font/poppins"
                android:hint="Data"
                android:imeOptions="flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="date"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTime"
            style="@style/CustomTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColorHint="@color/cl_c8c5c3"
            app:hintTextAppearance="@style/TextInputLayoutHintText"
            app:hintTextColor="@color/cl_c8c5c3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilLastName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTime"
                style="@style/CustomTextEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_general_stroke_input_fields"
                android:drawablePadding="9dp"
                android:focusable="false"
                android:fontFamily="@font/poppins"
                android:hint="Ora"
                android:imeOptions="flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="date"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSave"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_solid_cl_primary_radius_12dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:gravity="center"
            android:padding="15dp"
            android:text="Ruaj"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/tvSignIn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>